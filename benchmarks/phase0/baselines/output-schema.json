{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LianaSakana001/OmicsRepro/benchmarks/phase0/baseline-attempt-v1.schema.json",
  "title": "OmicsRepro Phase 0 baseline attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "baseline_id",
    "attempt",
    "decision",
    "detected_failure_families",
    "evidence",
    "remediation",
    "abstention_reason",
    "runtime_seconds",
    "token_usage",
    "tool_versions"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "baseline_id": {
      "enum": [
        "agent",
        "agent_expert_instructions",
        "native_validators",
        "omicsrepro",
        "agent_omicsrepro"
      ]
    },
    "attempt": {"type": "integer", "minimum": 1},
    "decision": {"enum": ["pass", "fail", "indeterminate"]},
    "detected_failure_families": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "remediation": {"type": ["string", "null"]},
    "abstention_reason": {"type": ["string", "null"]},
    "runtime_seconds": {"type": "number", "minimum": 0},
    "token_usage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output"],
          "properties": {
            "input": {"type": "integer", "minimum": 0},
            "output": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
